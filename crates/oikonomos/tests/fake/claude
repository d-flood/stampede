#!/usr/bin/env python3
import json
import os
import re
import select
import sys
import time
from pathlib import Path

FLAGS = {'--input-format': 'stream-json', '--output-format': 'stream-json'}
SWITCHES = ['--verbose', '--include-partial-messages', '--permission-prompt-tool=stdio']
ENV = {'CLAUDE_CODE_ENTRYPOINT': 'sdk-ts', 'CLAUDE_CODE_SDK_READS_SESSION_STATE': '1'}
RECORDED_CWD = '/tmp/oikonomos-chat'


def fail(reason):
    print(f'fake claude: {reason}', file=sys.stderr)
    sys.exit(2)


FIXTURES = Path(__file__).resolve().parent.parent / 'fixtures/chats/claude-code'


def fixture():
    name = os.environ.get('OIKONOMOS_FAKE_FIXTURE') or fail('OIKONOMOS_FAKE_FIXTURE is not set')
    if '/' in name:
        return Path(name)
    return FIXTURES / f'{name}.recorded.jsonl'


def kind(message):
    request = message.get('request', {})
    return message.get('type'), request.get('subtype'), request.get('cancel_queued'), message.get('priority')


def readline():
    global pending
    while b'\n' not in pending:
        chunk = os.read(0, 65536)
        if not chunk:
            return None
        pending += chunk
    line, _, pending = pending.partition(b'\n')
    return line


def waiting():
    global pending
    if not pending and select.select([0], [], [], 0)[0]:
        pending += os.read(0, 65536)
    return bool(pending)


def read(expected):
    while (received := readline()) is not None:
        message = json.loads(received)
        if kind(message)[:2] == ('control_request', 'get_usage') != kind(expected)[:2]:
            usage = json.loads((FIXTURES / 'usage.recorded.jsonl').read_text().splitlines()[1])['stdout']
            usage['response']['request_id'] = message['request_id']
            print(json.dumps(usage, ensure_ascii=False), flush=True)
            continue
        return message
    return None


def remap(message):
    text = json.dumps(message, ensure_ascii=False).replace(RECORDED_CWD, os.getcwd())
    for recorded, sent in uuids.items():
        text = text.replace(recorded, sent)
    return text


def record(entry):
    config = Path(os.environ.get('CLAUDE_CONFIG_DIR') or Path.home() / '.claude')
    project = config / 'projects' / re.sub(r'[^a-zA-Z0-9]', '-', os.getcwd())
    project.mkdir(parents=True, exist_ok=True)
    with open(project / f'{entry["sessionId"]}.jsonl', 'a') as session:
        session.write(remap(entry) + '\n')


def gate(name):
    gates = os.environ.get('OIKONOMOS_FAKE_GATES')
    if not gates:
        return
    path = Path(gates) / name
    path.touch()
    while path.exists():
        time.sleep(0.02)


args = sys.argv[1:]
for flag, value in FLAGS.items():
    if flag not in args or args.index(flag) + 1 >= len(args) or args[args.index(flag) + 1] != value:
        fail(f'{flag} {value} is missing from {args}')
for switch in SWITCHES:
    if switch not in args:
        fail(f'{switch} is missing from {args}')
for name, value in ENV.items():
    if os.environ.get(name) != value:
        fail(f'{name} is not {value}')

entries = [json.loads(line) for line in fixture().read_text().splitlines()]
start = 0
if '--resume' in args:
    session = args[args.index('--resume') + 1]
    start = next((index + 1 for index, entry in enumerate(entries) if entry.get('resume') == session), 0)

request_ids = {}
uuids = {}
pending = b''
for entry in entries[start:]:
    if 'resume' in entry:
        break
    if 'stdin' in entry:
        message = read(entry['stdin'])
        if message is None:
            sys.exit(0)
        if kind(message) != kind(entry['stdin']):
            fail(f'expected {kind(entry["stdin"])} but read {kind(message)}')
        if 'request_id' in message:
            request_ids[entry['stdin']['request_id']] = message['request_id']
        if 'uuid' in message and 'uuid' in entry['stdin']:
            uuids[entry['stdin']['uuid']] = message['uuid']
    elif 'args' in entry:
        expected = entry['args']
        if not any(args[i:i + len(expected)] == expected for i in range(len(args))):
            fail(f'{expected} is missing from {args}')
    elif 'session' in entry:
        record(entry['session'])
    elif 'gate' in entry:
        gate(entry['gate'])
    else:
        message = entry['stdout']
        response = message.get('response', {})
        if message.get('type') == 'control_response' and response.get('request_id') in request_ids:
            response['request_id'] = request_ids[response['request_id']]
        if message.get('type') == 'result' and waiting():
            fail(f'read {pending!r} before the turn ended')
        print(remap(message), flush=True)

while readline() is not None:
    pass
