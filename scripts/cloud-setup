#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
export CI=true
export GIT_TERMINAL_PROMPT=0

sudo -n apt-get update
sudo -n env DEBIAN_FRONTEND=noninteractive apt-get install -y build-essential curl xz-utils

rust_version=$(rustc --version | cut -d' ' -f2)
if ! printf '%s\n' 1.96 "$rust_version" | sort -V -C; then
    if command -v rustup >/dev/null; then
        rustup update stable
        rustup default stable
    else
        curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal
    fi
fi
printf '%s\n' 1.96 "$(rustc --version | cut -d' ' -f2)" | sort -V -C

if [[ $(pnpm --version 2>/dev/null) != 12.23.0 ]]; then
    npm install --global --prefix "$HOME/.local" pnpm@12.23.0
fi
[[ $(pnpm --version) == 12.23.0 ]]

if [[ $(zig version 2>/dev/null) != 0.17.* ]]; then
    scratch=$(mktemp -d)
    trap 'rm -rf "$scratch"' EXIT
    curl -fsSL https://ziglang.org/download/index.json -o "$scratch/index.json"
    read -r url sha < <(python3 -c '
import json, sys
entry = json.load(open(sys.argv[1]))["0.17.1"]["x86_64-linux"]
print(entry["tarball"], entry["shasum"])' "$scratch/index.json")
    curl -fL --proto '=https' -o "$scratch/zig.tar.xz" "$url"
    echo "$sha  $scratch/zig.tar.xz" | sha256sum --check --quiet
    mkdir -p "$HOME/.local/zig" "$HOME/.local/bin"
    tar -xJf "$scratch/zig.tar.xz" -C "$HOME/.local/zig"
    ln -sfn "$HOME/.local/zig/$(basename "$url" .tar.xz)/zig" "$HOME/.local/bin/zig"
fi

[[ $(zig version) == 0.17.* ]]
python3 scripts/check_web.py
STAMPEDE_BUILD_ROOT="$PWD" cargo build --locked --jobs 4
